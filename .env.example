# Vorlage: als ".env.local" kopieren und echte Werte eintragen.
# Zu finden im Supabase-Dashboard unter Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Live-Spielstände auf den Tippkarten (API-Sports, Rene, 15.10.2026).
# Nur auf dem Server, NIE mit NEXT_PUBLIC_ davor. Auf Vercel eintragen unter
# Vercel → Settings → Environment Variables. Leer = keine Live-Stände,
# die App läuft normal weiter.
API_SPORTS_KEY=
